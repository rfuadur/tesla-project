# Copy this file to .env and adjust. Never commit .env; only this example file is tracked.
# Generate a real secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=tesla_pool
POSTGRES_PORT=5432

# --- API ---
# Used when you run the API on your machine (npm run dev / npm test), so it points at localhost.
DATABASE_URL=postgres://tesla:local-dev-only-change-me@localhost:5432/tesla_pool
JWT_SECRET=replace-me-with-at-least-32-random-characters
API_PORT=4000
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Web (docker compose) ---
WEB_PORT=3000
